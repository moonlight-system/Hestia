{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Hestia",
  "version": "0.2.3",
  "identifier": "com.lin.hestia",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Hestia",
        "width": 800,
        "height": 600,
        "maximized": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEE3NTc5OTc4MDY5NkY4QTQKUldTaytKWUdlSmxYcDExcmhLbWdvVldnTUxqeDU2eE5JTkZjS0RvbkN4NG9BSG0zN0ZWS1RHdUYK",
      "endpoints": [
        "https://github.com/moonlight-system/Hestia/releases/latest/download/latest.json"
      ]
    }
  }
}